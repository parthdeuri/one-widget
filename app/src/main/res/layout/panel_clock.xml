<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Shown instead of @id/date when the date position is "above the time". -->
    <TextClock
        android:id="@+id/date_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFCCCCCC"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextClock
        android:id="@+id/time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:autoSizeMaxTextSize="64sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeTextType="uniform"
        android:gravity="center_horizontal|bottom"
        android:maxLines="1"
        android:textColor="#FFFFFFFF" />

    <!-- The size is computed in code, so the time sits right above the date and the block stays centred. -->
    <TextClock
        android:id="@+id/time_fixed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="40sp" />

    <TextClock
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFCCCCCC"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFB74D"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
